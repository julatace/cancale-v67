{
  "manifest_version": 3,
  "name": "VRM - Vinted Sync",
  "version": "4.19.0",
  "description": "Synchronise tes comptes et donnees Vinted (annonces detaillees, ventes, achats, messages) vers VRM, depuis TON navigateur. + Panneau VRM sur Vinted (numero de la paire, prix achat, case garage, paires a relancer - affichage seul). + Assistant Leboncoin : prepare tes annonces (titre, description, prix, categorie, photos) et pre-remplit le formulaire de depot pour que tu publies en 1 clic. Aucune publication automatique.",
  "permissions": ["cookies", "storage", "alarms", "scripting", "tabs", "downloads"],
  "host_permissions": [
    "https://*.vinted.fr/*",
    "https://*.vinted.com/*",
    "https://*.vinted.it/*",
    "https://*.vinted.de/*",
    "https://*.vinted.net/*",
    "https://*.leboncoin.fr/*",
    "https://lgonxzrzjcqthjtbdpzo.supabase.co/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://*.vinted.fr/*",
        "https://*.vinted.com/*",
        "https://*.vinted.it/*",
        "https://*.vinted.de/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.vinted.fr/*",
        "https://*.vinted.com/*",
        "https://*.vinted.it/*",
        "https://*.vinted.de/*"
      ],
      "js": ["vinted-panel.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://cancale-v67-ten.vercel.app/*",
        "https://cancale-v67.vercel.app/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://*.leboncoin.fr/*"],
      "js": ["lbc-inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://*.leboncoin.fr/*"],
      "js": ["lbc.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": [
        "https://*.vinted.fr/*",
        "https://*.vinted.com/*",
        "https://*.vinted.it/*",
        "https://*.vinted.de/*"
      ]
    },
    {
      "resources": ["lbc-inject.js"],
      "matches": ["https://*.leboncoin.fr/*"]
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Shop Cancale35 - Vinted Sync" }
}
