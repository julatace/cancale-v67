        {
          "composant": "Comptabilite",
          "condition": "ongletColisVu==='envoyer'",
          "nom": "VueColisEnvoyerHaut",
          "laPlusGrande": true
        }
      ]
    },
    {
      "fichier": "coeur/FeuillesCompta.jsx",
