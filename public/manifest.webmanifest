{
  "name": "VRM",
  "short_name": "VRM",
  "description": "Ton poste de pilotage de revendeur : annonces, ventes, achats, rangement, marge et comptabilité au même endroit.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F2F2F7",
  "theme_color": "#F2F2F7",
  "share_target": {
    "action": "/partage-achat",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "photo", "accept": ["image/*"] }] }
  },
  "icons": [
    { "src": "/vrm-icon-v5-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/vrm-icon-v5-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/vrm-maskable-v5-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
