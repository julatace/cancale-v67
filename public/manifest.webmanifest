{
  "id": "/",
  "name": "VRM",
  "short_name": "VRM",
  "description": "Ton poste de pilotage de revendeur : annonces, ventes, achats, rangement, marge et comptabilité au même endroit.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#F2F2F7",
  "theme_color": "#F2F2F7",
  "categories": [
    "business",
    "productivity",
    "finance"
  ],
  "share_target": {
    "action": "/partage-achat",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "photo",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  },
  "icons": [
