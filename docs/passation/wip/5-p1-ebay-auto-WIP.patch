+// ── « JE NE DOIS RIEN AVOIR À REMPLIR » (15 octobre, décision de Julien) ─────
+// Quand le formulaire n'envoie PAS de catégorie, c'est eBay qui la propose pour
+// CE titre — le chemin REST déjà prouvé de `pubinfo` (Taxonomy
+// get_category_suggestions), jamais un appel Trading inédit. La PREMIÈRE
+// suggestion est prise (c'est eBay qui propose, jamais nous) et la réponse la
+// NOMME (`categorieChoisie`). Aucune suggestion, arbre illisible, appel raté ⇒
+// refus PROPRE avant tout AddFixedPriceItem (502 `categorie-pas-su`) : rien
+// n'est publié sur une catégorie devinée. Une suggestion non-feuille ⇒ eBay
+// répondra Ack=Failure, remonté tel quel (le filet existant).
+// ⚠️ JAMAIS le titre d'exemple de `pubinfo` : un titre vide reste un 400.
+async function categorieSuggeree(token, titre) {
+  const H = { 'Accept-Language': 'fr-FR', 'Content-Language': 'fr-FR' };
+  const tree = await ebayJson(`${EBAY_API}/commerce/taxonomy/v1/get_default_category_tree_id?marketplace_id=EBAY_FR`, token, H);
+  const treeId = (tree.data && tree.data.categoryTreeId) || '';
+  if (!treeId) return null;
+  const sugg = await ebayJson(`${EBAY_API}/commerce/taxonomy/v1/category_tree/${treeId}/get_category_suggestions?q=${encodeURIComponent(String(titre).slice(0, 80))}`, token, H);
+  const c = sugg.data && Array.isArray(sugg.data.categorySuggestions) && sugg.data.categorySuggestions[0] && sugg.data.categorySuggestions[0].category;
+  if (!(c && c.categoryId)) return null;
+  return { categoryId: String(c.categoryId), categoryName: c.categoryName || String(c.categoryId), par: 'ebay-suggestion' };
+}
+// L'ÉTAT déduit de l'annonce Vinted quand le formulaire n'en envoie pas : la
+// table EXACTE, LA MÊME que dans l'app (§11 — `audit-ebay-publication.cjs`
+// compare les deux copies, texte et sorties). Hors table ⇒ « Occasion » (3000)
+// N'EST PAS posé en silence : refus `etat-pas-su` qui NOMME le libellé Vinted.
+// <etat-vinted-ebay>
+const ETAT_VINTED_EBAY = { 'Neuf avec étiquette': '1000', 'Neuf sans étiquette': '1500', 'Très bon état': '3000', 'Bon état': '3000', 'Satisfaisant': '3000' };
+const conditionDeVinted = (etat) => ETAT_VINTED_EBAY[String(etat == null ? '' : etat).trim()] || '';
+// </etat-vinted-ebay>
+// Complète l'item AVANT tout appel qui écrit : la catégorie par eBay, l'état
+// par la table — chacun rendu dans la réponse (`categorieChoisie`,
+// `etatChoisi`) pour que l'écran DISE ce qui a été rempli automatiquement.
+// Rend `{ it, categorieChoisie?, etatChoisi? }` ou `{ err }` (rien ne part).
+async function completerPublication(it, token, verbe) {
+  const out = { it: { ...it } };
+  if (!out.it.categoryId) {
+    const c = await categorieSuggeree(token, out.it.title);
+    if (!c) return { err: { status: 502, body: { ok: false, reason: 'categorie-pas-su', error: `eBay n'a pas proposé de catégorie pour ce titre — rien n'a été ${verbe}. Choisis la catégorie dans le formulaire.` } } };
+    out.it.categoryId = c.categoryId;
+    out.categorieChoisie = c;
+  }
+  if (!out.it.conditionId) {
+    const etat = String(out.it.etatVinted == null ? '' : out.it.etatVinted).trim();
+    const id = conditionDeVinted(etat);
+    if (!id) return { err: { status: 400, body: { ok: false, reason: 'etat-pas-su', error: (etat ? `Je ne sais pas traduire l'état Vinted « ${etat} » en état eBay` : `L'état de l'objet manque (et l'état Vinted de la paire n'est pas connu)`) + ` — choisis l'état dans le formulaire. Rien n'a été ${verbe}.` } } };
+    out.it.conditionId = id;
+    out.etatChoisi = { conditionId: id, etatVinted: etat, par: 'vinted' };
+    // Recalé sur les états PERMIS par la catégorie, quand on les a (le même
+    // Sell Metadata que `pubinfo`) — et c'est DIT (`par: 'recale'`), jamais en
+    // silence. Lecture ratée ⇒ on garde la table : eBay reste juge (Ack).
+    const cp = await ebayJson(`${EBAY_API}/sell/metadata/v1/marketplace/EBAY_FR/get_item_condition_policies?filter=categoryIds:%7B${out.it.categoryId}%7D`, token, { 'Accept-Language': 'fr-FR', 'Content-Language': 'fr-FR' });
+    const p0 = cp.data && Array.isArray(cp.data.itemConditionPolicies) && cp.data.itemConditionPolicies[0];
+    const permis = (p0 && Array.isArray(p0.itemConditions) ? p0.itemConditions : []).map((x) => String(x.conditionId)).filter(Boolean);
+    if (permis.length && !permis.includes(id)) {
+      const choisi = permis.includes('3000') ? '3000' : permis[0];
+      out.it.conditionId = choisi;
+      out.etatChoisi = { conditionId: choisi, etatVinted: etat, par: 'recale' };
+    }
+  }
+  return out;
+}
