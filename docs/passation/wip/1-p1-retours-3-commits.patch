@@ -0,0 +1,221 @@
+// ⚠️⚠️ CONTRÔLE PERMANENT — LE COLIS DE RETOUR D'UNE VENTE N'EST PAS UN COLIS À POSTER.
+//
+// Plainte de Julien (15 octobre) : « il y a une vente sur laquelle j'ai eu un
+// litige et ça me propose d'imprimer le bordereau, cela ne sert à rien car il
+// est arrivé en point relais ». MESURÉ (lecture seule, base de production) :
+//   · tx 22592792923 (tomj606) — la LISTE dit « La livraison n'a pas encore eu
+//     lieu - colis déposé en bureau de Poste ou point relais » avec
+//     `needs_action` ; le DÉTAIL dit 440 « Retour initié », expédition 310.
+//   · le TÉMOIN 23052006117 (angeled92) — MÊME texte, mais `waiting` et un
+//     détail 230 : c'est le colis de l'acheteur, une vraie vente en route.
+//   · la CONVERSATION du retour (25325126937, côté vendeur, transaction 440) :
+//     « Ton colis est arrivé ! Rends-toi au point relais Consigne Pickup
+//     Super U Cancale, RUE DE LA BRETONNIERE, 35260 CANCALE pour le
+//     récupérer. » — AUCUN code, AUCUN QR.
+//   · l'achat en litige (conv 25211546616) : « Retourne la commande d'ici le
+//     14 oct. … Sinon, tu devras garder l'article et ton paiement sera
+//     transféré au vendeur. »
+//
+// Ce contrôle EXÉCUTE les vraies règles (extraites par Babel, jamais
+// recopiées) : `aExpedier` (src/App.jsx), `A_EXPEDIER` (background.js),
+// `aExpedier` (api/widget.js), `retourAuRelais`, `venteStage`, et côté
+// extension `retraitDeConversation` / `renvoiDeConversation`.
+// `--prouve` RÉAFFAIBLIT les règles (needs_action ⇒ toujours à expédier, côté
+// vendeur jamais lu) : les contrôles doivent repasser au ROUGE — « la fonction
+// n'existait pas avant » n'est pas une preuve (§6.1).
+// Aucune donnée réelle : des libellés SYSTÈME de Vinted, aucun acheteur.
+const fs = require('fs'), path = require('path'), vm = require('vm');
+const R = path.join(__dirname, '..');
+const PROUVE = process.argv.includes('--prouve');
+let ko = 0;
+const dit = (c, m, d) => { if (!c) ko++; console.log(`${c ? '✅' : '❌'} ${m}${d ? ' — ' + d : ''}`); };
+const essaie = (m, f) => { try { f(); } catch (e) { dit(false, m, String(e && e.message || e).slice(0, 200)); } };
+
+let parser;
+try { parser = require(path.join(R, 'node_modules', '@babel', 'parser')); }
+catch (e) { console.log('❌ analyseur Babel introuvable — ' + e.message); process.exit(1); }
+
+// Les RÉAFFAIBLISSEMENTS de `--prouve` : la règle d'avant le 15 octobre
+// (needs_action ⇒ toujours à expédier) et le côté vendeur jamais lu.
+const MUTS = {
+  'src/App.jsx': [
+    [/if \(t === 'needs_action'\) return isAwaitingShipStatus\(s\) \|\| !DEJA_PARTI\.test\(s\);/, "if (t === 'needs_action') return true;"],
+    [/if \(estRetourVente\(o\)\) return false;/, ''],
+  ],
+  'vinted-sync-extension/background.js': [
+    [/if \(t === 'needs_action'\) return AWAITING_SHIP\(s\) \|\| !DEJA_PARTI\.test\(s\);/, "if (t === 'needs_action') return true;"],
+    [/const retourVendeur = String\(t\.current_user_side \|\| ''\) === 'seller' && Number\(t\.status\) === 440;/, "const retourVendeur = false;"],
+  ],
+  'api/widget.js': [
+    [/if \(t === 'needs_action'\) return awaitingShip\(s\) \|\| !DEJA_PARTI\.test\(s\);/, "if (t === 'needs_action') return true;"],
+  ],
+};
+
+function sources(fichier, noms, opts) {
+  let src = fs.readFileSync(path.join(R, fichier), 'utf8');
+  if (PROUVE && MUTS[fichier]) for (const [re, rep] of MUTS[fichier]) src = src.replace(re, rep);
+  const ast = parser.parse(src, Object.assign({ sourceType: 'module', plugins: ['jsx'], errorRecovery: true }, opts || {}));
+  const trouve = {};
+  const visite = (n) => {
+    if (!n || typeof n !== 'object') return;
+    if (Array.isArray(n)) { n.forEach(visite); return; }
+    if (n.type === 'VariableDeclaration') {
+      for (const d of n.declarations) {
+        const nom = d.id && d.id.name;
+        if (nom && noms.includes(nom) && !trouve[nom]) trouve[nom] = 'const ' + src.slice(d.start, d.end) + ';';
+      }
+    }
+    if (n.type === 'FunctionDeclaration' && n.id && noms.includes(n.id.name) && !trouve[n.id.name]) trouve[n.id.name] = src.slice(n.start, n.end);
+    for (const k of Object.keys(n)) { if (k === 'loc' || k === 'start' || k === 'end') continue; const v = n[k]; if (v && typeof v === 'object') visite(v); }
+  };
+  visite(ast.program);
+  return trouve;
+}
+function charge(fichier, noms, base, opts) {
+  const t = sources(fichier, noms, opts);
+  const ctx = Object.assign({}, base || {});
+  vm.createContext(ctx);
+  for (const nom of noms) {
+    if (!t[nom]) continue;
+    try { vm.runInContext(t[nom].replace(/^export\s+/, '') + `\nthis.${nom} = ${nom};`, ctx); } catch (_) { /* dépendance absente : le contrôle le dira */ }
+  }
+  return ctx;
+}
+
+const C = { warn: '#a', danger: '#b', muted: '#c', blue: '#d', accent: '#e' };
+const app = charge('src/App.jsx', ['classifyOrderStatus', 'isAtRelayStatus', 'isAwaitingShipStatus', 'needsBordereau', 'PAS_UN_ENVOI', 'tusDe', 'DEJA_PARTI', 'VENTE_TERMINEE', 'estRetourVente', 'venteQuiRevient', 'aExpedier', 'retourAuRelais', 'marquerRetours']);
+const appComp = charge('src/App.jsx', ['venteStage', 'saleOutcome'], Object.assign({}, app, {
+  C, INV_STATUS: { online: { color: '#f' } },
+  venteExpediee: () => false, isShipDone: () => false,
+}));
+const ext = charge('vinted-sync-extension/background.js', ['AWAITING_SHIP', 'AT_RELAY', 'PAS_UN_ENVOI', 'DEJA_PARTI', 'besoinBordereauTexte', 'A_EXPEDIER', 'sansBalises', 'CODE_APRES', 'CONV_SORTANT', 'CONV_ARRIVE', 'retraitDeConversation', 'MOIS_FR', 'renvoiDeConversation'], {}, { sourceType: 'script', plugins: [] });
+const wid = charge('api/widget.js', ['awaitingShip', 'PAS_UN_ENVOI', 'DEJA_PARTI', 'besoinBordereauTexte', 'aExpedier'], {});
+
+// Les trois lecteurs ; sur un code qui n'a pas la règle unique, on mesure ce
+// que l'écran faisait vraiment (comme audit-statuts).
+const appA = (o) => app.aExpedier ? app.aExpedier(o) : app.needsBordereau(o.status);
+const extA = (o) => ext.A_EXPEDIER ? ext.A_EXPEDIER(o) : ext.AWAITING_SHIP(o.status);
+const widA = (o) => wid.aExpedier ? wid.aExpedier(o) : wid.awaitingShip(o.status);
+
+// ── LE CORPUS (libellés SYSTÈME mesurés) ─────────────────────────────────────
+const T_RELAIS = "La livraison n'a pas encore eu lieu - colis déposé en bureau de Poste ou point relais";
+const RETOUR = { transaction_id: '22592792923', status: T_RELAIS, transaction_user_status: 'needs_action' };           // le cas de Julien
+const TEMOIN = { transaction_id: '23052006117', status: T_RELAIS, transaction_user_status: 'waiting' };                // vraie vente en route
+const A_POSTER = { transaction_id: '23220410615', status: 'Le paiement a été validé', transaction_user_status: 'needs_action' }; // vraie vente à poster
+
+essaie('(0) les règles se chargent', () => {
+  dit(typeof app.aExpedier === 'function' && typeof ext.A_EXPEDIER === 'function' && typeof wid.aExpedier === 'function', 'aExpedier (app), A_EXPEDIER (extension) et aExpedier (widget) sont lues dans leurs fichiers');
+  dit(typeof app.retourAuRelais === 'function', 'retourAuRelais (app) est lue', typeof app.retourAuRelais);
+  dit(String(app.DEJA_PARTI) === String(ext.DEJA_PARTI) && String(ext.DEJA_PARTI) === String(wid.DEJA_PARTI), 'DEJA_PARTI est la MÊME expression dans l\'app, l\'extension et le widget (§11)', `${app.DEJA_PARTI} · ${ext.DEJA_PARTI} · ${wid.DEJA_PARTI}`);
+});
+
+// (1) Le cas mesuré : le retour au relais n'est À EXPÉDIER nulle part.
+essaie('(1) le retour au relais', () => {
+  const r = { app: appA(RETOUR), ext: extA(RETOUR), widget: widA(RETOUR) };
+  dit(!r.app && !r.ext && !r.widget, 'tx 22592792923 (needs_action + « colis déposé… ») n\'est à expédier NI dans l\'app, NI dans l\'extension, NI dans le widget', JSON.stringify(r));
+  dit(app.retourAuRelais(RETOUR) === true, '… et c\'est un COLIS À RETIRER (`retourAuRelais` = true)', String(app.retourAuRelais(RETOUR)));
+});
+
+// (2) Les deux sens : le témoin et la vraie vente à poster ne bougent pas.
+essaie('(2) les deux sens', () => {
+  const t = { app: appA(TEMOIN), ext: extA(TEMOIN), widget: widA(TEMOIN) };
+  dit(!t.app && !t.ext && !t.widget, 'le témoin 23052006117 (MÊME texte, waiting) reste « en route », pas à expédier', JSON.stringify(t));
+  dit(app.retourAuRelais(TEMOIN) === false, '… et il n\'est PAS un colis à retirer (c\'est le colis de l\'ACHETEUR)', String(app.retourAuRelais(TEMOIN)));
+  const p = { app: appA(A_POSTER), ext: extA(A_POSTER), widget: widA(A_POSTER) };
+  dit(p.app && p.ext && p.widget, 'la vraie vente à poster (needs_action + « paiement validé ») reste à expédier PARTOUT — « pas su » ne cache pas une vente', JSON.stringify(p));
+  dit(app.retourAuRelais(A_POSTER) === false, '… et elle n\'est pas « à retirer »', String(app.retourAuRelais(A_POSTER)));
+  // Les textes needs_action qui attendent VRAIMENT l'envoi restent à poster.
+  for (const s of ['Bordereau envoyé au vendeur', "Bordereau d'envoi commandé", '']) {
+    const o = { status: s, transaction_user_status: 'needs_action' };
+    dit(appA(o) && extA(o) && widA(o), `needs_action + « ${s || '(statut vide — pas su)'} » reste à expédier partout`, JSON.stringify([appA(o), extA(o), widA(o)]));
+  }
+});
+
+// (3) Le DÉTAIL de transaction (440) gagne, et seulement quand il est CONNU.
+essaie('(3) le détail 440', () => {
+  const avecDetail = { status: 'Bordereau envoyé au vendeur', transaction_user_status: 'needs_action', _retour: { ship: 'Bordereau envoyé au vendeur' } };
+  dit(appA(avecDetail) === false, 'une vente dont le détail dit « retour » (440, `_retour`) n\'est JAMAIS à expédier, même sur « Bordereau envoyé au vendeur »', String(appA(avecDetail)));
+  dit(appA({ status: 'Bordereau envoyé au vendeur', transaction_user_status: 'needs_action' }) === true, '… mais « pas su » (pas de `_retour`) ne fait pas disparaître la vraie vente', 'true attendu');
+  // `marquerRetours` pose `_retour` par IDENTITÉ (n° de transaction), jamais ailleurs.
+  const items = [{ transaction_id: 111, status: 'Retour initié' }, { transaction_id: 222, status: 'Le paiement a été validé', transaction_user_status: 'needs_action' }];
+  const m = app.marquerRetours(items, { '111': { ship: T_RELAIS, at: '2026-10-15' } });
+  dit(!!(m[0]._retour) && !m[1]._retour, '`marquerRetours` marque par n° de transaction, et ne touche pas les autres ventes', JSON.stringify(m.map(o => !!o._retour)));
+  dit(app.retourAuRelais(m[0]) === true, 'détail 440 + expédition « déposé… relais » ⇒ colis à retirer, même quand la liste dit encore « Retour initié »', String(app.retourAuRelais(m[0])));
