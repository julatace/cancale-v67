+// ⚠️ LE COLIS DE RETOUR N'EST PAS UN COLIS À POSTER (15 octobre). Mesuré (tx
+// 22592792923) : la liste dit « colis déposé en bureau de Poste ou point
+// relais » avec `needs_action` — c'est le colis de RETOUR, arrivé au relais
+// pour LUI. Le widget comptait 6 colis à expédier pour 5 réels. MÊME
+// EXPRESSION que `DEJA_PARTI` (src/App.jsx) et l'extension (§11).
+const DEJA_PARTI = /colis\s+d[ée]pos[ée]|livraison\s+n.a\s+pas\s+encore\s+eu\s+lieu|livr[ée]e?(?![a-zà-ÿ])|achemin|exp[ée]di[ée]e?(?![a-zà-ÿ])|non\s+r[ée]clam/i;
 export function aExpedier(o) {
   if (!o) return false;
   const s = String(o.status || '');
   if (PAS_UN_ENVOI.test(s)) return false;
   const t = String(o.transaction_user_status || '').toLowerCase();
-  if (t === 'needs_action') return true;
+  if (t === 'needs_action') return awaitingShip(s) || !DEJA_PARTI.test(s);
   if (t === 'waiting' || t === 'completed' || t === 'failed') return false;
   return besoinBordereauTexte(s);
 }
