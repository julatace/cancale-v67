+    { const i = APP.indexOf('const lireRetoursVente'); const corps = i >= 0 ? APP.slice(i, APP.indexOf('\n};', i)) : '';
+      dit(i < 0 || (/status=eq\.440/.test(corps) && /=== '440'/.test(corps)), '`lireRetoursVente` ne lit QUE les transactions en retour (filtre 440, revérifié ligne à ligne) — jamais une preuve de vente', i < 0 ? 'absente' : 'filtre 440 introuvable'); }
     dit(!fe.length, 'dans l\'extension, seuls `lireVentesProuvees` et `capterPreuvesVente` le lisent', fe.join(' · '));
