+// ═══════════════════════════════════════════════════════════════════════════
+// BANC : « TOUT IMPRIMER » — APERÇU, VIEUX BORDEREAUX, TRI PAR DATE DE VENTE
+//        (node scripts/bancs/imprimer.cjs — après `npm run build` · port 5851)
+// ═══════════════════════════════════════════════════════════════════════════
+// Julien, 15 octobre : « le bouton tout imprimer m'a donné des bordereaux
+// d'anciennes ventes qui datent d'il y a un mois » · « les bordereaux triés par
+// date de vente, plus récent en haut, on ne trie pas par compte » · « tout
+// imprimer à la suite, sans erreur ». REMESURÉ le 16 octobre sur sa base : la
+// capture du compte 3168505556 est figée au 20 septembre, la vente 22403756745
+// du 18 septembre y est restée « needs_action » avec son PDF en base → elle
+// entrait dans le lot, en silence.
+//
+// Ce banc rend l'app sur des ventes INVENTÉES (il vit dans le dépôt, public) :
+//   9105 « Echec »  compte_a, vendue il y a 12 h, bordereau SANS PDF réel
+//                   (témoin filename présent) → retenue, ÉCHOUE à l'impression ;
+//   9102 « Bravo »  compte_b, 1 j, PDF email          → retenue ;
+//        (⚠️ servie AUSSI sous compte_a : le dédoublonnage par commande doit
+//         n'en imprimer qu'UNE) ;
+//   L1   « Charlie » Leboncoin, 1,5 j, voucher        → dans l'aperçu, mise de
+//                   côté (extension absente ici) — DEUX plateformes mélangées ;
+//   9101 « Alpha »  compte_a, 2 j, PDF capté          → retenue ;
+//   9104 « Deja »   compte_b, 3 j, PDF email, MARQUÉE IMPRIMÉE → mise de côté
+//                   par défaut, la case la réinclut ;
+//   L2   « Delta »  Leboncoin, 5 j, voucher           → aperçu, mise de côté ;
+//   9103 « Vieux »  compte_a, 40 j, needs_action figé, PDF email → ANCIENNE :
+//                   mise de côté par défaut, la case la réinclut ;
+//   9106 « Finalisee » compte_a, 35 j, vente FINALISÉE avec un email de
+//                   bordereau → n'apparaît NULLE PART (ni liste, ni aperçu).
+// Il exige :
+//   1. la liste des colis est triée par date de VENTE décroissante (la vieille
+//      vente est EN BAS, la plus récente EN HAUT — jamais l'ordre des comptes) ;
+//   2. « Tout imprimer » ouvre un APERÇU (data-lot-apercu) — jamais une
+//      impression à l'aveugle — trié date décroissante, DEUX plateformes
+//      confondues, chaque ligne retenue ou mise de côté avec sa raison ;
+//   3. l'ancienne (9103) et la déjà imprimée (9104) sont HORS du lot par
+//      défaut ; les cases les réincluent ; la doublonnée ne compte qu'une fois ;
+//   4. l'impression dit ses échecs PAR bordereau (data-lot-echecs) et
+//      « ↻ Réimprimer les échecs » ne relit QUE les échecs ;
+//   5. ce qui est parti est marqué imprimé : le lot suivant le met de côté ;
+//   6. l'autre sens : la vente finalisée n'apparaît nulle part, et aucun
+//      débordement, aucune erreur, aucun écran tombé (390 et 1512 px).
+// On juge les ATTRIBUTS (`data-lot-*`, `data-retenu`, `data-plateforme`) et
+// l'ORDRE rendu, jamais une formulation (§6.5).
+const path = require('path');
+let chromium;
+try { ({ chromium } = require(path.join(__dirname, '..', '..', 'node_modules', 'playwright'))); }
+catch (_) { ({ chromium } = require('/home/user/cancale-v67/node_modules/playwright')); }
+const { metaVersData } = require('./_meta.cjs');
+const fs = require('fs'), http = require('http'), os = require('os');
+const DIST = path.join(__dirname, '..', '..', 'dist');
+const PORT = Number(process.env.PORT || 5851);
+
+const MAINTENANT = Date.now();
+const H = 3600000;
+const ilYaH = (h) => new Date(MAINTENANT - h * H).toISOString();
+const PDF_B64 = fs.readFileSync(path.join(__dirname, 'bordereau-test.b64'), 'utf8').trim();
+
+// tx → { compte(s), titre, vendue il y a N h, statut }
+const vente = (tx, titre, h, st) => ({ transaction_id: tx, title: titre, price: { amount: '50.0', currency_code: 'EUR' },
+  status: st || 'Le paiement a été validé', transaction_user_status: st ? 'completed' : 'needs_action', date: ilYaH(h) });
+const V9105 = vente(9105, 'Echec Lot taille 39', 12);
+const V9102 = vente(9102, 'Bravo Lot taille 41', 24);
+const V9101 = vente(9101, 'Alpha Lot taille 42', 48);
+const V9104 = vente(9104, 'Deja Lot taille 40', 72);
+const V9103 = vente(9103, 'Vieux Lot taille 43', 40 * 24);
+const V9106 = vente(9106, 'Finalisee Lot taille 38', 35 * 24, 'Vente finalisée');
+const ACCOUNTS = [
+  { id: 1, vinted_user_id: '111', login: 'compte_a', domain: 'www.vinted.fr', updated_at: ilYaH(0) },
+  { id: 2, vinted_user_id: '222', login: 'compte_b', domain: 'www.vinted.fr', updated_at: ilYaH(0) },
+];
+// ⚠️ 9102 est servie sous les DEUX comptes : c'est le cas que le dédoublonnage
+//    par (plateforme, commande) doit attraper — une commande, UN bordereau.
+const VENTES_111 = [V9105, V9101, V9103, V9106, V9102];
+const VENTES_222 = [V9102, V9104];
+const bordEmail = (tx, titre, pdf) => ({ id: 'email_bord_' + tx, data: { transaction: String(tx), uid: '111', filename: 'bordereau-' + tx + '.pdf', modele: titre, article: titre, receivedAt: ilYaH(2), pdfB64: pdf } });
+const lbcVente = (txId, titre, h) => ({ txId, itemId: 'it-' + txId, title: titre, price: 4400, isSeller: true,
+  dateVente: ilYaH(h), stepStatus: '', stepLabel: 'À expédier', label: { voucherUrl: 'https://api.leboncoin.fr/x/' + txId, reference: 'REF-' + txId } });
+const ROWS = [
+  { id: 'main', data: { vinted_bords_printed: { 9104: ilYaH(20) } } },
+  { id: 'harvest_111_orders_sold', data: { capturedAt: ilYaH(0.2), payload: { my_orders: VENTES_111 } } },
+  { id: 'harvest_222_orders_sold', data: { capturedAt: ilYaH(0.4), payload: { my_orders: VENTES_222 } } },
+  { id: 'harvest_111_label_9101', data: { tx: '9101', item: '', capturedAt: ilYaH(30), pdfB64: PDF_B64 } },
+  bordEmail(9102, 'Bravo Lot taille 41', PDF_B64),
+  bordEmail(9103, 'Vieux Lot taille 43', PDF_B64),
+  bordEmail(9104, 'Deja Lot taille 40', PDF_B64),
+  bordEmail(9105, 'Echec Lot taille 39', null),       // témoin présent, PDF jamais arrivé
+  bordEmail(9106, 'Finalisee Lot taille 38', PDF_B64), // vente finalisée : NE DOIT apparaître nulle part
+  { id: 'lbc_ventes', data: { ventes: {
+    // ⚠️ L2 AVANT L1 exprès : l'ordre d'insertion est l'ordre « avant » — le
+    //    tri par date doit remettre L1 (1,5 j) devant L2 (5 j).
+    'lbc-tx-2': lbcVente('lbc-tx-2', 'Delta LBC taille 45', 5 * 24),
+    'lbc-tx-1': lbcVente('lbc-tx-1', 'Charlie LBC taille 44', 36),
+  } } },
+];
+
+let ko = 0;
+const dit = (c, m, d) => { if (!c) ko++; console.log((c ? 'OK  ' : 'KO  ') + m + (d ? ' — ' + d : '')); };
+const essaie = async (nom, f) => { try { await f(); } catch (e) { dit(false, nom + ' — le contrôle a pu s’exécuter', String(e && e.message).split('\n')[0].slice(0, 160)); } };
+
+const types = { '.js': 'text/javascript', '.css': 'text/css', '.html': 'text/html', '.png': 'image/png', '.svg': 'image/svg+xml', '.json': 'application/json', '.webmanifest': 'application/json', '.woff2': 'font/woff2' };
+const srv = http.createServer((q, r) => {
+  let f = q.url.split('?')[0]; if (f === '/' || !path.extname(f)) f = '/index.html';
+  const p = path.join(DIST, f);
+  if (!fs.existsSync(p)) { r.writeHead(404); return r.end(); }
+  r.writeHead(200, { 'content-type': types[path.extname(p)] || 'application/octet-stream' }); fs.createReadStream(p).pipe(r);
+});
+srv.on('error', (e) => { console.log('KO  le port ' + PORT + ' est pris (' + e.code + ') — relance le banc seul'); process.exit(1); });
+srv.listen(PORT);
+const projette = (row, sel) => {
+  if (!sel || sel === '*') return row;
+  const out = {};
+  for (const part of sel.split(',')) {
+    const m = /^(?:([^:]+):)?(.+)$/.exec(part.trim()); if (!m) continue;
+    const src = m[2], alias = m[1] || src.split(/->>|->/).pop();
+    if (src === 'id') { out[alias] = row.id; continue; }
+    if (src === 'data') { out[alias] = row.data; continue; }
+    let v = row.data; for (const seg of src.replace(/^data(->>|->)/, '').split(/->>|->/)) v = v == null ? null : v[seg];
+    out[alias] = v == null ? null : v;
+  }
+  return out;
+};
+
+// Ce que la page lit comme octets de PDF (pour « Réimprimer ne relit QUE les échecs »).
+const LECTURES_PDF = { n: 0 };
+async function preparer(b, vp) {
+  const ctx = await b.newContext({ viewport: vp, ...(vp.width < 600 ? { isMobile: true, hasTouch: true } : {}) });
+  // L'onglet d'impression réservé au clic : on le referme, le banc n'imprime pas.
+  ctx.on('page', (p) => { if (p !== ctx.pages()[0]) p.close().catch(() => {}); });
+  const pg = await ctx.newPage();
+  const errs = []; pg.on('pageerror', (e) => errs.push(e.message));
+  await pg.addInitScript(() => { try { localStorage.setItem('vrm_acces_direct', '1'); } catch (_) {} });
+  await pg.route(/^https?:\/\/(?!localhost|127\.0\.0\.1)/i, (r) => (['image', 'media', 'font'].includes(r.request().resourceType()) ? r.abort() : r.continue()));
+  await pg.route('**/rest/v1/**', (route) => {
+    const u = decodeURIComponent(metaVersData(route.request().url()));
+    const j = (d) => route.fulfill({ status: 200, contentType: 'application/json', headers: { 'access-control-allow-origin': '*' }, body: JSON.stringify(d) });
+    if (route.request().method() !== 'GET') return j([]);
+    if (/select=owner/.test(u)) return route.fulfill({ status: 400, contentType: 'application/json', headers: { 'access-control-allow-origin': '*' }, body: '{"m":1}' });
+    if (/\/rest\/v1\/vinted_accounts/.test(u)) return j(ACCOUNTS);
+    if (/select=b:data->>pdfB64/.test(u)) LECTURES_PDF.n++;
+    const sel = (/[?&]select=([^&]*)/.exec(u) || [])[1] || null;
+    // Filtres PostgREST `data->>x=(not.)is.null` (§6.3 : le filtre compte autant
+    // que la projection — une ligne sans PDF ne passe pas `not.is.null`).
+    const filtres = [...u.matchAll(/[?&]data->>(\w+)=(not\.)?is\.null/g)].map((x) => ({ champ: x[1], nul: !x[2] }));
+    const passe = (r) => filtres.every((f) => { const v = (r.data || {})[f.champ]; const estNul = (v === null || v === undefined || v === ''); return f.nul ? estNul : !estNul; });
+    const forme = (r) => (sel && !/^id,data/.test(sel)) ? projette(r, sel) : ({ ...r, updated_at: r.data.capturedAt || ilYaH(0), cap: r.data.capturedAt });
+    const eq = /id=eq\.([^&]*)/.exec(u);
+    if (eq) return j(ROWS.filter((r) => r.id === eq[1]).filter(passe).map(forme));
+    const lk = /id=like\.([^&]*)/.exec(u);
+    if (lk) { const re = new RegExp('^' + lk[1].replace(/[.]/g, '\\.').replace(/[*%]/g, '.*') + '$'); return j(ROWS.filter((r) => re.test(r.id)).filter(passe).map(forme)); }
+    return j([]);
+  });
+  await pg.route('**/api/**', (r) => r.fulfill({ status: 200, contentType: 'application/json', body: '{"pret":true}' }));
+  return { ctx, pg, errs };
+}
+async function sain(pg, ecran) {
+  const r = await pg.evaluate(() => ({ sw: document.documentElement.scrollWidth, cw: document.documentElement.clientWidth, t: document.body.innerText }));
+  dit(r.sw <= r.cw + 1, `${ecran} : aucun débordement horizontal`, `${r.sw} > ${r.cw}`);
+  const m = /n'a pas pu s'afficher|n’a pas pu s’afficher|Cannot access|is not defined/.exec(r.t);
+  dit(!m, `${ecran} : l'écran n'est pas tombé sur le garde-fou`, m && m[0]);
+}
+// L'ordre des cartes de colis, lu par leur TITRE (chaque titre est unique).
+const ordreCartes = (pg) => pg.$$eval('[data-bord-card]', (els) => els.map((e) => {
+  const m = /(Echec|Bravo|Alpha|Deja|Vieux|Finalisee|Charlie|Delta) (?:Lot|LBC)/.exec(e.innerText || ''); return m ? m[1] : '?';
+}));
+const lireApercu = (pg) => pg.evaluate(() => {
+  const ap = document.querySelector('[data-lot-apercu]');
+  if (!ap) return null;
+  return {
+    n: Number(ap.getAttribute('data-lot-apercu')),
+    lignes: [...ap.querySelectorAll('[data-lot-ligne]')].map((l) => ({
+      cle: l.getAttribute('data-lot-ligne'), retenu: l.getAttribute('data-retenu'),
+      plateforme: l.getAttribute('data-plateforme'), txt: l.innerText,
+    })),
+    imprimer: (document.querySelector('[data-lot-imprimer]') || {}).getAttribute ? Number(document.querySelector('[data-lot-imprimer]').getAttribute('data-lot-imprimer')) : null,
+  };
+});
+
+(async () => {
+  let b;
+  try {
+    b = await chromium.launch({ executablePath: '/opt/pw-browsers/chromium-1194/chrome-linux/chrome', args: ['--use-angle=swiftshader', '--no-sandbox', '--no-proxy-server'] });
+
+    // ── 1512 px : le scénario complet ──────────────────────────────────────
+    {
+      console.log('── 1512 px');
+      const { ctx, pg, errs } = await preparer(b, { width: 1512, height: 950 });
+      await essaie('liste des colis', async () => {
+        await pg.goto(`http://localhost:${PORT}/?tab=cat_bord`, { waitUntil: 'domcontentloaded' });
+        await pg.waitForFunction(() => /pr[êe]ts?\s+[àa]\s+imprimer|colis à envoyer/i.test(document.body.innerText || ''), null, { timeout: 25000, polling: 250 }).catch(() => {});
+        await pg.waitForTimeout(2500);
+        const ordre = await ordreCartes(pg);
+        console.log('    cartes : ' + ordre.join(' → '));
+        dit(ordre.length >= 5, 'les colis à envoyer sont rendus', ordre.join(','));
+        dit(ordre[0] === 'Echec', 'la vente la plus RÉCENTE est en haut (12 h)', 'premier = ' + ordre[0]);
+        dit(ordre.filter((x) => x !== '?').pop() === 'Vieux', 'la vente d\'il y a 40 jours est EN BAS — plus jamais en tête de liste', 'dernier = ' + ordre.filter((x) => x !== '?').pop());
+        const iB = ordre.indexOf('Bravo'), iA = ordre.indexOf('Alpha'), iD = ordre.indexOf('Deja');
+        dit(iB >= 0 && iA > iB && iD > iA, 'date de vente décroissante, jamais l\'ordre des comptes (Bravo b · Alpha a · Deja b)', ordre.join(' → '));
+        dit(!ordre.includes('Finalisee'), 'la vente FINALISÉE n\'est pas un colis — son vieil email de bordereau ne la ressuscite pas', ordre.join(','));
+        await sain(pg, 'Colis');
+      });
+      let apres = null;
+      await essaie('aperçu du lot', async () => {
+        const btn = await pg.$('[data-lot-defaut]');
+        dit(!!btn, 'le bouton « Tout imprimer » est là');
+        dit(btn && (await btn.getAttribute('data-lot-defaut')) === '3', 'le bouton compte la sélection PAR DÉFAUT (3 : sans l\'ancienne, la déjà imprimée, les Leboncoin sans extension, le doublon)', btn && (await btn.getAttribute('data-lot-defaut')));
+        await btn.click();
+        await pg.waitForSelector('[data-lot-apercu]', { timeout: 8000 });
+        const a = await lireApercu(pg);
+        dit(!!a, 'le clic ouvre un APERÇU — il n\'imprime plus à l\'aveugle');
+        dit(a && a.n === 3, 'l\'aperçu retient 3 bordereaux par défaut', a && String(a.n));
+        const cles = a.lignes.map((l) => l.cle);
+        console.log('    aperçu : ' + a.lignes.map((l) => `${l.cle}:${l.retenu}`).join(' · '));
+        // Ordre attendu, toutes plateformes confondues : 12 h · 1 j (·doublon) · 1,5 j LBC · 2 j · 3 j · 5 j LBC · 40 j
+        const sansDouble = cles.filter((c, i) => cles.indexOf(c) === i);
+        dit(JSON.stringify(sansDouble) === JSON.stringify(['v9105', 'v9102', 'lbc:lbc-tx-1', 'v9101', 'v9104', 'lbc:lbc-tx-2', 'v9103']),
+          'l\'aperçu est trié par date de vente décroissante, DEUX plateformes confondues', sansDouble.join(' → '));
+        dit(a.lignes.some((l) => l.plateforme === 'Leboncoin') && a.lignes.some((l) => l.plateforme === 'Vinted'),
+          'les deux plateformes sont dans la même liste', [...new Set(a.lignes.map((l) => l.plateforme))].join(','));
+        const l9103 = a.lignes.find((l) => l.cle === 'v9103'), l9104 = a.lignes.find((l) => l.cle === 'v9104');
+        dit(l9103 && l9103.retenu === '0' && /40\s*j/.test(l9103.txt), 'l\'ancienne (40 j) est mise de côté AVEC son âge', l9103 && l9103.txt.replace(/\n/g, ' · ').slice(0, 120));
+        dit(l9104 && l9104.retenu === '0' && /imprim/i.test(l9104.txt), 'la déjà imprimée est mise de côté et le dit', l9104 && l9104.txt.replace(/\n/g, ' · ').slice(0, 120));
+        const lbc1 = a.lignes.find((l) => l.cle === 'lbc:lbc-tx-1');
+        dit(lbc1 && lbc1.retenu === '0' && /extension/i.test(lbc1.txt), 'le colis Leboncoin est montré, mis de côté avec le geste (extension absente ici)', lbc1 && lbc1.txt.replace(/\n/g, ' · ').slice(0, 120));
+        // ⚠️ ON JUGE LA SORTIE, PAS L'ÉTAGE QUI DÉDOUBLONNE (§6.5) : 9102 est
+        //    servie sous DEUX comptes — qu'elle soit dédoublonnée en amont
+        //    (`loadOrders`, le cas aujourd'hui) ou par la garde du lot, le
+        //    résultat exigé est le même : UNE seule ligne retenue par commande.
+        dit(new Set(cles).size === 7, 'les 7 colis sont dans l\'aperçu, chacun une fois', `${a.lignes.length} ligne(s) · ${new Set(cles).size} commande(s)`);
+        const nDouble = a.lignes.filter((l) => l.cle === 'v9102' && l.retenu === '1').length;
+        dit(nDouble === 1, 'la commande 9102, servie sous DEUX comptes, n\'est retenue qu\'UNE fois (dédoublonnage par commande)', `${nDouble} retenue(s)`);
+        // Les cases réincluent — et le nombre du bouton suit.
+        await pg.click('[data-lot-inclure-imprimes]');
+        await pg.waitForTimeout(250);
+        let a2 = await lireApercu(pg);
+        dit(a2 && a2.n === 4 && (a2.lignes.find((l) => l.cle === 'v9104') || {}).retenu === '1', 'la case « déjà imprimés » réinclut la déjà imprimée', a2 && String(a2.n));
+        await pg.click('[data-lot-inclure-anciens]');
+        await pg.waitForTimeout(250);
+        a2 = await lireApercu(pg);
+        dit(a2 && a2.n === 5 && (a2.lignes.find((l) => l.cle === 'v9103') || {}).retenu === '1', 'la case « anciens » réinclut la vente de 40 j — rien n\'est caché', a2 && String(a2.n));
+        // On referme et on rouvre : le lot PAR DÉFAUT repart propre.
+        await pg.click('[data-lot-apercu] button:has-text("Annuler")');
+        await pg.waitForTimeout(250);
+      });
+      await essaie('impression, échecs, reprise', async () => {
+        await pg.click('[data-lot-defaut]');
+        await pg.waitForSelector('[data-lot-imprimer]', { timeout: 8000 });
+        await pg.click('[data-lot-imprimer]');
+        const msg = await pg.waitForFunction(() => { const m = /(\d+) sur (\d+) imprimé[^\n]*/.exec(document.body.innerText || ''); return m ? m[0] : null; }, null, { timeout: 25000 }).then((h) => h.jsonValue()).catch(() => null);
+        dit(!!msg && /^2 sur 3/.test(msg), 'le lot dit le nombre RÉELLEMENT imprimé (2 sur 3 — Echec n\'a pas son PDF)', msg || '(aucun message)');
+        await pg.waitForSelector('[data-lot-echecs]', { timeout: 8000 });
+        const ech = await pg.evaluate(() => { const e = document.querySelector('[data-lot-echecs]'); return e ? { n: Number(e.getAttribute('data-lot-echecs')), cles: [...e.querySelectorAll('[data-lot-echec]')].map((x) => x.getAttribute('data-lot-echec')), txt: e.innerText } : null; });
