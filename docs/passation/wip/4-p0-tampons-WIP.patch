diff --git a/scripts/audit-tampons.cjs b/scripts/audit-tampons.cjs
new file mode 100644
index 0000000..1125cb6
--- /dev/null
+++ b/scripts/audit-tampons.cjs
@@ -0,0 +1,320 @@
+// ⚠️⚠️ CONTRÔLE PERMANENT — LA POSITION DU TAMPON PAR TYPE DE BORDEREAU (15 oct.)
+//
+// Demande de Julien : « l'application enregistre tous les bordereaux de
+// différents types que l'utilisateur a eus, et l'endroit où le numéro est
+// tamponné ; une fois cliqué dessus, il peut régler l'endroit où il a placé
+// ses tampons ; adapter pour imprimante thermique et classique ».
+//
+// MESURÉ AVANT DE CODER : la clé des emplacements était la TAILLE de page seule
+// (`bordereauFormatKey`) — or InPost, Mondial Relay et Colissimo sont tous en
+// A4 portrait (595×842, § impression du dossier). Trois mises en page
+// différentes partageaient donc UN emplacement : le tampon réglé pour l'une
+// atterrissait sur l'autre, potentiellement sur son code-barres. Et
+// l'imprimante thermique n'avait AUCUN réglage (petit N° figé en bas à gauche),
+// ni la taille du tampon.
+//
+// CE QUE CE CONTRÔLE EXIGE, en EXÉCUTANT le vrai code extrait d'App.jsx sur des
+// PDF synthétiques passés par save/load (§6.3 — la forme reçue de Vinted) :
+//   1. le TYPE est reconnu DANS le PDF (transporteur + format), sinon format
+//      seul, dit (`connu:false`) ;
+//   2. deux transporteurs au MÊME format de page n'ont JAMAIS le même réglage ;
+//   3. classique et thermique ont chacun LEUR réglage ;
+//   4. le réglage HISTORIQUE (clé format seul) reste lu — une nouveauté
+//      n'éteint pas ce qui marchait ;
+//   5. type jamais réglé ⇒ position par DÉFAUT, et `defaut:true` le DIT ;
+//   6. la TAILLE (`pos.s`) agit vraiment sur le cartouche (mesuré au rendu PDF) ;
+//   7. le réglage thermique DÉPLACE le petit N° dans l'étiquette — et sans
+//      réglage, il reste en bas à gauche (l'historique) ;
+//   8. le tampon s'ajoute à une COPIE : les octets SOURCE ne bougent pas.
+//
+// §6.1 : sur le code d'AVANT (sans le bloc <tampons-regle>), l'audit REJOUE la
+// règle d'avant (clé = format seul, aucune imprimante, aucune taille) au lieu
+// de mourir — « la fonction n'existait pas avant » n'est pas une preuve, c'est
+// le COMPORTEMENT d'avant qui doit sortir rouge. `--mutation x` réaffaiblit la
+// règle nouvelle et doit faire repasser les contrôles au rouge :
+//   cletype · imprimante · taille · thermpos · defaut · legacy · ditdefaut
+const fs = require('fs'), vm = require('vm'), path = require('path');
+const racine = path.join(__dirname, '..');
+let APP = fs.readFileSync(path.join(racine, 'src', 'App.jsx'), 'utf8');
+const PL = require(path.join(racine, 'node_modules', 'pdf-lib', 'cjs', 'index.js'));
+
+const MUT = (() => { const i = process.argv.indexOf('--mutation'); return i > -1 ? process.argv[i + 1] : ''; })();
+
+let ko = 0;
+const dit = (ok, nom, det) => { if (!ok) ko++; console.log(`${ok ? '✅' : '❌'} ${nom}${det ? ' — ' + det : ''}`); };
+const essaie = async (quoi, fn) => { try { return await fn(); } catch (e) { dit(false, quoi, String((e && e.stack || e.message) || e).slice(0, 300)); return null; } };
+
+// ── Mutations : on réaffaiblit le CODE avant de l'extraire, et on vérifie que
+//    la mutation a bien mordu (une mutation qui ne s'applique pas prouverait
+//    n'importe quoi).
+const muter = (src) => {
+  const avant = src;
+  if (MUT === 'cletype') {
+    // la clé retombe sur le FORMAT seul : deux transporteurs se partagent un réglage
+    src = src.replace(/\/\/ <tampons-regle>[\s\S]*?\/\/ <\/tampons-regle>/, (bloc) => bloc.replace(/type\.cle/g, 'type.fmt'));
+  } else if (MUT === 'imprimante') {
+    src = src.replace(/const cleTampon = \([^\n]*\n/,
+      "const cleTampon = (typeCle, mode) => String(typeCle || '');\n");
+  } else if (MUT === 'taille') {
+    src = src.replace(/const s = tailleTampon\(pos\);\n    const boxW = Math\.min\(width - 4/,
+      'const s = 1;\n    const boxW = Math.min(width - 4');
+  } else if (MUT === 'thermpos') {
+    src = src.replace(/const xr = pos && typeof pos\.xr === 'number' \? Math\.max\(0, Math\.min\(1, pos\.xr\)\) : 0;\n  const yrTop = pos && typeof pos\.yr === 'number' \? Math\.max\(0, Math\.min\(1, pos\.yr\)\) : 1;/,
+      'const xr = 0;\n  const yrTop = 1;');
+  } else if (MUT === 'defaut') {
+    src = src.replace(/\/\/ <tampons-regle>[\s\S]*?\/\/ <\/tampons-regle>/, (bloc) => bloc.replace(/defaut: true/g, 'defaut: false'));
+  } else if (MUT === 'legacy') {
+    src = src.replace(/const ancien = type\.cle !== type\.fmt \? f\[type\.fmt\] : null;/, 'const ancien = null;');
+  } else if (MUT === 'ditdefaut') {
+    // une entrée écrite aux valeurs par défaut redevient « réglée » : le mot ne
+    // suit plus la position (le défaut disparaît après la première impression)
+    src = src.replace(/ && !estDefautTampon\(exact, m\)/, '').replace(/ && !estDefautTampon\(ancien, m\)/, '');
+  }
+  if (MUT && src === avant) { console.log(`❌ la mutation « ${MUT} » ne s'applique pas — rien n'est prouvé`); process.exit(1); }
+  return src;
+};
+APP = muter(APP);
+
+// ── Extraction du VRAI code (le même harnais qu'audit-impression.cjs) ─────────
+const morceau = (re, quoi, optionnel) => { const m = re.exec(APP); if (!m) { if (!optionnel) dit(false, `${quoi} introuvable dans App.jsx`); return null; } return m[0]; };
+const parts = [
+  morceau(/const IMPR_MODES = \[[^\n]*\n/, '`IMPR_MODES`'),
+  morceau(/const imprMode = \([^\n]*\n/, '`imprMode`'),
+  morceau(/const PAS_L_ETIQUETTE = \/[^\n]*\n/, '`PAS_L_ETIQUETTE`'),
+  morceau(/const _mulM = \([^\n]*\n/, '`_mulM`'),
+  morceau(/const _apM = \([^\n]*\n/, '`_apM`'),
+  morceau(/const relevePage = \([\s\S]*?\n\};/, '`relevePage`'),
+  morceau(/const _couperSelon = \([\s\S]*?\n\};/, '`_couperSelon`'),
+  morceau(/const zoneEtiquette = \([\s\S]*?\n\};/, '`zoneEtiquette`'),
+  morceau(/const bordereauFormatKey = [^\n]*\n/, '`bordereauFormatKey`'),
+  morceau(/const smartDefaultBordPos = [^\n]*\n/, '`smartDefaultBordPos`'),
+  morceau(/const drawBordereauStamp = \([\s\S]*?\n\};/, '`drawBordereauStamp`'),
+  morceau(/const drawSkuThermique = \([\s\S]*?\n\};/, '`drawSkuThermique`'),
+];
+// Le bloc de la règle nouvelle. ABSENT sur le code d'avant : on rejoue alors la
+// règle d'AVANT (posForFormat : clé = bordereauFormatKey(w,h), défaut
+// smartDefaultBordPos, aucune imprimante, aucune taille) — c'est elle qui doit
+// sortir ROUGE, pas une erreur d'extraction (§6.1).
+const bloc = morceau(/\/\/ <tampons-regle>[\s\S]*?\/\/ <\/tampons-regle>/, '`<tampons-regle>`', true);
+const AVANT = !bloc;
+if (AVANT) console.log('⚠️  <tampons-regle> absent : on rejoue la règle d\'AVANT (clé = format seul, aucune imprimante, aucune taille).');
+
+const EMULATION_AVANT = `
+const typeDepuisPage = (PL, page) => { const { width, height } = page.getSize(); const fmt = bordereauFormatKey(width, height); return { cle: fmt, fmt, transporteur: '', w: width, h: height, connu: false }; };
+const cleTampon = (typeCle) => String(typeCle || '');
+const tailleTampon = () => 1;
+const posTampon = (formats, type) => { const f = formats || {}; const p = f[type.fmt]; if (p && typeof p.xr === 'number') return { xr: p.xr, yr: p.yr, s: 1, defaut: false }; return { ...smartDefaultBordPos(type.w, type.h), s: 1, defaut: true }; };
+const noterTampon = (formats, type, mode, pos) => ({ ...(formats || {}), [type.fmt]: { xr: pos.xr, yr: pos.yr } });
+const typesTampon = (formats) => Object.keys(formats || {}).map((k) => ({ cle: k }));
+const nomTransporteurBordereau = () => '';
+`;
+// ⚠️ L'ancien `drawSkuThermique`/`drawBordereauStamp` existent dans les DEUX
+// versions : eux se testent tels quels (c'est la vraie preuve rouge/vert).
+// L'ancien drawSkuThermique appelle parfois `tailleTampon` (version nouvelle) —
+// l'émulation ci-dessus la fournit à 1 quand le bloc est absent.
+let R = null;
+if (parts.every(Boolean)) {
+  const src = parts.join('\n') + '\n' + (AVANT ? EMULATION_AVANT : bloc);
+  try {
+    const ctx = { console: { log() {} }, TextDecoder, Date, Math, Number, Object, String };
+    vm.createContext(ctx);
+    vm.runInContext(`${src}\nglobalThis.R = { imprMode, zoneEtiquette, drawBordereauStamp, drawSkuThermique, bordereauFormatKey, smartDefaultBordPos, typeDepuisPage, cleTampon, tailleTampon, posTampon, noterTampon, typesTampon, nomTransporteurBordereau };`, ctx, { filename: 'App.jsx' });
+    R = ctx.R;
+  } catch (e) { dit(false, 'le code du tampon se charge', String((e && e.message) || e)); }
+}
+
+// ── Les PDF synthétiques, passés par save/load (§6.3) ────────────────────────
+const A4 = [595.28, 841.89];
+const pdfTexte = async (mots, paysage) => {
+  const d = await PL.PDFDocument.create();
+  const p = d.addPage(paysage ? [A4[1], A4[0]] : A4);
+  const f = await d.embedFont(PL.StandardFonts.Helvetica);
+  let y = p.getSize().height - 60;
+  for (const m of mots) { p.drawText(m, { x: 40, y, size: 11, font: f }); y -= 22; }
+  for (let i = 0; i < 10; i++) { p.drawText('contenu quelconque du bordereau ' + i, { x: 40, y: y - i * 18, size: 9, font: f }); }
+  return PL.PDFDocument.load(await d.save());
+};
+// La mise en page « colonnes » d'audit-impression (étiquette isolable) pour le thermique.
+const pdfColonnes = async () => {
+  const d = await PL.PDFDocument.create();
+  const p = d.addPage(A4);
+  const f = await d.embedFont(PL.StandardFonts.Helvetica);
+  p.drawRectangle({ x: 20, y: 380, width: 260, height: 430, borderColor: PL.rgb(0, 0, 0), borderWidth: 1 });
+  for (let i = 0; i < 12; i++) p.drawText('ADRESSE DESTINATION 35260', { x: 28, y: 780 - i * 30, size: 9, font: f });
+  p.drawRectangle({ x: 30, y: 700, width: 240, height: 60, color: PL.rgb(0, 0, 0) });
+  p.drawText('Fiche destinataire', { x: 340, y: 700, size: 14, font: f });
+  p.drawText('A mettre a l interieur du colis', { x: 340, y: 680, size: 10, font: f });
+  for (let i = 0; i < 8; i++) p.drawText('Dimensions max de mon colis', { x: 340, y: 640 - i * 24, size: 9, font: f });
+  return d.save();
+};
+// Relevé des RECTANGLES rendus (via le vrai relevePage, à travers zoneEtiquette
+// on n'a pas accès direct : on recharge le doc et on appelle relevePage via un
+// petit pont — le plus simple est de réutiliser zoneEtiquette ? Non : on relit
+// les cadres nous-mêmes avec le code extrait).
+const rectsDe = (page) => {
+  // On passe par le même chemin que zoneEtiquette : relevePage est dans le vm,
+  // pas exporté — on réutilise zoneEtiquette ? Il filtre. On ré-extrait ici.
+  const src2 = parts.slice(0, 8).join('\n') + '\nglobalThis.releve = (PL, page) => {\n' +
+    "  const ctx = page.doc.context, out = [];\n" +
+    "  let res = null; try { res = ctx.lookup(page.node.get(PL.PDFName.of('Resources'))); } catch (_) {}\n" +
+    "  const c = page.node.get(PL.PDFName.of('Contents'));\n" +
+    "  const fluxDe = (ref) => { try { const o = ctx.lookup(ref); if (!o) return '';\n" +
+    "    if (o instanceof PL.PDFRawStream) return new TextDecoder('latin1').decode(PL.decodePDFRawStream(o).decode());\n" +
+    "    if (o.asArray) return o.asArray().map((r) => fluxDe(r)).join('\\n'); return ''; } catch (_) { return ''; } };\n" +
+    '  relevePage(PL, ctx, fluxDe(c), res, [1, 0, 0, 1, 0, 0], out, 0);\n  return out;\n};';
+  const ctx2 = { console: { log() {} }, TextDecoder };
+  vm.createContext(ctx2);
+  vm.runInContext(src2, ctx2, { filename: 'releve.js' });
+  return ctx2.releve(PL, page);
+};
+// Le cartouche/SKU AJOUTÉ par un tampon : les rectangles présents APRÈS qui ne
+// l'étaient pas AVANT (comparés par coin+taille arrondis).
+const rectsAjoutes = (avant, apres) => {
+  const cle = (o) => [o.x, o.y, o.X, o.Y].map((v) => Math.round(v)).join(',');
+  const vus = new Set(avant.filter((o) => !o.s).map(cle));
+  return apres.filter((o) => !o.s && !vus.has(cle(o)));
+};
+
+(async () => {
+  if (!R) { console.log(`\n${ko} contrôle(s) au rouge.`); process.exit(1); }
+
+  // ── 1. LE TYPE EST RECONNU DANS LE PDF ─────────────────────────────────────
+  let tChrono = null, tMondial = null, tMuet = null;
+  await essaie('reconnaissance du type', async () => {
+    tChrono = R.typeDepuisPage(PL, (await pdfTexte(['CHRONOPOST', 'Point relais 35260'])).getPages()[0]);
+    tMondial = R.typeDepuisPage(PL, (await pdfTexte(['Mondial Relay', 'Point relais 35260'])).getPages()[0]);
+    tMuet = R.typeDepuisPage(PL, (await pdfTexte(['bordereau sans nom de transporteur'])).getPages()[0]);
+    dit(tChrono && tChrono.transporteur === 'chronopost' && tChrono.connu === true,
+      'un bordereau Chronopost est RECONNU comme type « chronopost »', tChrono && (tChrono.cle || ''));
+    dit(tMondial && tMondial.transporteur === 'mondial-relay',
+      'un bordereau Mondial Relay est reconnu comme type « mondial-relay »', tMondial && (tMondial.cle || ''));
+    dit(tChrono && tMondial && tChrono.cle !== tMondial.cle,
+      'deux transporteurs au MÊME format de page font DEUX types', `${tChrono && tChrono.cle} / ${tMondial && tMondial.cle}`);
+    dit(tMuet && tMuet.connu === false && tMuet.cle === tMuet.fmt,
+      'aucun transporteur lisible ⇒ type = format seul, et c\'est DIT (connu:false)', tMuet && tMuet.cle);
+  });
+  if (!tChrono || !tMondial || !tMuet) { console.log(`\n${ko} contrôle(s) au rouge.`); process.exit(ko ? 1 : 0); }
+
+  // ── 2. DEUX TRANSPORTEURS, MÊME FORMAT : JAMAIS LE MÊME RÉGLAGE ───────────
+  await essaie('isolation par type', async () => {
+    const f1 = R.noterTampon({}, tChrono, 'normale', { xr: 0.7, yr: 0.8, s: 1 });
+    const pM = R.posTampon(f1, tMondial, 'normale');
+    dit(!(Math.abs(pM.xr - 0.7) < 1e-6 && Math.abs(pM.yr - 0.8) < 1e-6),
+      'le tampon réglé pour Chronopost ne se pose PAS sur un Mondial Relay du même format',
+      `Mondial Relay reçoit xr=${pM.xr} yr=${pM.yr}`);
+    const pC = R.posTampon(f1, tChrono, 'normale');
+    dit(Math.abs(pC.xr - 0.7) < 1e-6 && Math.abs(pC.yr - 0.8) < 1e-6 && pC.defaut === false,
+      'et Chronopost retrouve bien SON réglage', `xr=${pC.xr} yr=${pC.yr}`);
+  });
+
+  // ── 3. CLASSIQUE ET THERMIQUE : CHACUN SON RÉGLAGE ─────────────────────────
+  await essaie('isolation par imprimante', async () => {
+    let f = R.noterTampon({}, tChrono, 'normale', { xr: 0.7, yr: 0.8, s: 1 });
+    f = R.noterTampon(f, tChrono, 'thermique', { xr: 1, yr: 0, s: 2 });
+    const pN = R.posTampon(f, tChrono, 'normale');
+    const pT = R.posTampon(f, tChrono, 'thermique');
+    dit(Math.abs(pN.xr - 0.7) < 1e-6 && Math.abs(pN.yr - 0.8) < 1e-6,
+      'régler le THERMIQUE ne bouge pas le réglage CLASSIQUE', `classique xr=${pN.xr} yr=${pN.yr}`);
+    dit(Math.abs(pT.xr - 1) < 1e-6 && Math.abs(pT.yr - 0) < 1e-6 && Math.abs(pT.s - 2) < 1e-6,
+      'et le thermique retrouve le sien (position + taille)', `thermique xr=${pT.xr} yr=${pT.yr} s=${pT.s}`);
+  });
+
+  // ── 4. LE RÉGLAGE HISTORIQUE (clé format seul) RESTE LU ────────────────────
+  await essaie('réglage historique conservé', async () => {
+    const ancien = { '595x842': { xr: 0.33, yr: 0.44 } };   // la forme d'AVANT, telle qu'en base
+    const pInc = R.posTampon(ancien, tMuet, 'normale');
+    dit(Math.abs(pInc.xr - 0.33) < 1e-6 && pInc.defaut === false,
+      'un type NON reconnu lit toujours le réglage historique de son format', `xr=${pInc.xr}`);
+    const pRec = R.posTampon(ancien, tMondial, 'normale');
+    dit(Math.abs(pRec.xr - 0.33) < 1e-6 && pRec.defaut === false,
+      'un type reconnu SANS réglage propre retombe sur l\'historique du format (rien d\'appris n\'est perdu)', `xr=${pRec.xr}`);
+  });
+
+  // ── 5. TYPE JAMAIS RÉGLÉ ⇒ DÉFAUT, ET C'EST DIT ───────────────────────────
+  await essaie('défaut dit', async () => {
+    const d1 = R.posTampon({}, tMondial, 'normale');
+    const def = R.smartDefaultBordPos(tMondial.w, tMondial.h);
+    dit(d1.defaut === true && Math.abs(d1.xr - def.xr) < 1e-6 && Math.abs(d1.yr - def.yr) < 1e-6,
+      'type jamais réglé ⇒ la position par DÉFAUT actuelle, et `defaut:true` le dit', `xr=${d1.xr} defaut=${d1.defaut}`);
+    const d2 = R.posTampon({}, tMondial, 'thermique');
+    dit(d2.defaut === true, 'pareil en thermique', `defaut=${d2.defaut}`);
+    // `posForType` NOTE le type dès le premier bordereau (c'est ce qui le fait
+    // apparaître dans « Mes bordereaux ») : l'entrée écrite aux valeurs par
+    // défaut doit RESTER dite « par défaut » — le mot suit la position.
+    const d3 = R.posTampon(R.noterTampon({}, tMondial, 'normale', { ...def, s: 1 }), tMondial, 'normale');
+    dit(d3.defaut === true && Math.abs(d3.xr - def.xr) < 1e-6,
+      'une entrée ÉCRITE aux valeurs par défaut reste DITE « par défaut »', `defaut=${d3.defaut}`);
+  });
+
+  // ── 6. LA TAILLE AGIT SUR LE CARTOUCHE (mesuré au RENDU du PDF) ────────────
+  await essaie('taille du cartouche', async () => {
+    const mesure = async (s) => {
+      const doc = await pdfTexte(['bordereau quelconque']);
+      const avant = rectsDe(doc.getPages()[0]);
+      const bold = await doc.embedFont(PL.StandardFonts.HelveticaBold);
+      const reg = await doc.embedFont(PL.StandardFonts.Helvetica);
+      R.drawBordereauStamp(doc, PL.rgb, bold, reg, '412', 'Salomon XT-6 blanc', { xr: 0.1, yr: 0.1, s });
+      const relu = await PL.PDFDocument.load(await doc.save({ useObjectStreams: false }));
+      const ajout = rectsAjoutes(avant, rectsDe(relu.getPages()[0]));
+      ajout.sort((a, b) => (b.X - b.x) * (b.Y - b.y) - (a.X - a.x) * (a.Y - a.y));
