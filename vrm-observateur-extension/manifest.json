{
  "manifest_version": 3,
  "name": "VRM Observateur",
  "version": "2.1.0",
  "description": "Note la forme des requêtes et des gestes faits sur Vinted et Vestiaire Collective (clics, frappe, pages, onglets) — jamais une valeur tapée. Rien ne quitte ton ordinateur.",
  "permissions": [
    "webRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://*.vestiairecollective.com/*"
  ],
  "background": {
    "service_worker": "fond.js"
  },
  "action": {
    "default_title": "VRM Observateur",
    "default_popup": "fenetre.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.vinted.fr/*",
        "https://*.vinted.com/*",
        "https://*.vinted.be/*",
        "https://*.vinted.es/*",
        "https://*.vinted.it/*",
        "https://*.vinted.de/*",
        "https://*.vestiairecollective.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}