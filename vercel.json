{
  "crons": [
    {
      "path": "/api/ship-reminders",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/ebay-callback",
      "destination": "/api/ebay?mode=callback"
    },
    {
      "source": "/api/ebay-deletion",
      "destination": "/api/ebay?mode=deletion"
    },
    {
      "source": "/api/sante",
      "destination": "/api/compte?mode=sante"
    },
    {
      "source": "/api/stripe-webhook",
      "destination": "/api/compte?mode=webhook"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
