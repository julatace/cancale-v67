{
  "regions": [
    "dub1"
  ],
  "git": {
    "deploymentEnabled": {
      "claude/**": false
    }
  },
  "crons": [
    {
      "path": "/api/ship-reminders",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/rappel-soir",
      "schedule": "0 18 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/ebay-callback",
      "destination": "/api/ebay?mode=callback"
    },
    {
      "source": "/api/ebay-deletion",
      "destination": "/api/ebay?mode=deletion"
    },
    {
      "source": "/api/sante",
      "destination": "/api/compte?mode=sante"
    },
    {
      "source": "/api/stripe-webhook",
      "destination": "/api/compte?mode=webhook"
    },
    {
      "source": "/api/superpdp",
      "destination": "/api/compte?mode=superpdp"
    },
    {
      "source": "/api/detourage",
      "destination": "/api/ai?mode=detourage"
    },
    {
      "source": "/api/rappel-soir",
      "destination": "/api/ship-reminders?moment=soir"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self), payment=(), usb=(), serial=(), bluetooth=(), hid=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
