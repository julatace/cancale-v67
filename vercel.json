{
  "regions": [
    "dub1"
  ],
  "git": {
    "deploymentEnabled": {
      "claude/**": false
    }
  },
  "crons": [
    {
      "path": "/api/ship-reminders",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/rappel-soir",
      "schedule": "0 18 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/ebay-callback",
      "destination": "/api/ebay?mode=callback"
    },
    {
      "source": "/api/ebay-deletion",
      "destination": "/api/ebay?mode=deletion"
    },
    {
      "source": "/api/sante",
      "destination": "/api/compte?mode=sante"
    },
    {
      "source": "/api/stripe-webhook",
      "destination": "/api/compte?mode=webhook"
    },
    {
      "source": "/api/superpdp",
      "destination": "/api/compte?mode=superpdp"
    },
    {
      "source": "/api/detourage",
      "destination": "/api/ai?mode=detourage"
    },
    {
      "source": "/api/rappel-soir",
      "destination": "/api/ship-reminders?moment=soir"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self), payment=(), usb=(), serial=(), bluetooth=(), hid=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/((?!sw\\.js).*)",
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: https://tiles.openfreemap.org; font-src 'self' data:; connect-src 'self' https://lgonxzrzjcqthjtbdpzo.supabase.co wss://lgonxzrzjcqthjtbdpzo.supabase.co https://tiles.openfreemap.org https://cdn.jsdelivr.net https://*.vinted.net https://api-adresse.data.gouv.fr https://nominatim.openstreetmap.org data: blob:; media-src 'self' blob: data:; worker-src 'self' blob:; frame-src blob: https://challenges.cloudflare.com chrome-extension: moz-extension:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
