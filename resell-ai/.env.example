# PostgreSQL (via docker-compose.yml). Sans base, l'API bascule en mémoire.
DATABASE_URL="postgresql://resell:resell@localhost:5433/resell_ai?schema=public"

# Port de l'API
PORT=8787

# IA (OPTIONNELLE). Sans clé → logique déterministe + gabarits variés.
# Avec clé → réponses/rédaction générées par Claude.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-haiku-4-5-20251001"

# Origines autorisées à appeler l'API (extension + dashboard). * en dev.
CORS_ORIGIN="*"
