{
  "name": "resell-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Assistant IA de revente — assistance humaine, aucune automatisation externe.",
  "type": "module",
  "workspaces": [
    "apps/dashboard"
  ],
  "scripts": {
    "dev": "tsx watch services/api/src/server.ts",
    "start": "tsx services/api/src/server.ts",
    "dashboard": "npm --workspace apps/dashboard run dev",
    "seed": "tsx scripts/seed.ts",
    "prisma:push": "prisma db push --schema data/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema data/prisma/schema.prisma",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "test": "tsx scripts/test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "prisma": "^5.19.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
