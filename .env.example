# ─────────────────────────────────────────────────────────────────────────────
# Variables d'environnement — À POSER DANS VERCEL (Settings → Environment
# Variables), JAMAIS dans le dépôt. Ce fichier ne contient que des exemples.
# ─────────────────────────────────────────────────────────────────────────────

# ── NOTIFICATIONS PUSH (obligatoire) ─────────────────────────────────────────
# ⚠️ VRAI SECRET. L'ancienne clé privée traînait dans le dépôt (qui est public) :
# n'importe qui pouvait envoyer une notification sur les téléphones du vendeur.
# La paire a été régénérée ; la clé publique vit dans le code (c'est sa nature),
# la privée UNIQUEMENT ici. Sans elle, l'app n'envoie plus aucune notification
# et le dit — elle ne repart pas sur une clé connue de tous.
VAPID_PRIVATE_KEY=

# Adresse de contact exigée par la norme Web Push (transmise au service de
# notification). Ce n'est pas un secret, mais ce n'est pas au dépôt de porter
# l'email personnel de quelqu'un. Défaut : mailto:contact@vrm.center
PUSH_CONTACT=mailto:contact@vrm.center

# ── BASE DE DONNÉES ──────────────────────────────────────────────────────────
# Clé de SERVICE Supabase — utilisée uniquement par les fonctions serverless
# (api/*.js). ⚠️ Elle CONTOURNE RLS : chaque lecture doit donc être cadrée par
# vendeur (voir api/_lib/owner.js, `duVendeur`). Tant qu'elle n'est pas posée,
# les fonctions retombent sur la clé publique — ce qui marche aujourd'hui mais
# CASSERA le jour où RLS sera activé.
SUPABASE_SERVICE_KEY=

# Propriétaire par défaut des emails entrants tant qu'il n'y a qu'un vendeur.
# (UUID du compte Supabase.) Sans lui, et une fois la base cloisonnée, les
# emails partent en quarantaine au lieu d'être traités.
VRM_OWNER_UID=

# ── ASSISTANT IA (facultatif) ────────────────────────────────────────────────
# Clé Anthropic pour la réécriture d'annonces. Sans elle, l'app garde ses
# suggestions calculées et le dit — elle n'invente rien.
AI_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ CE QUI NE PEUT PAS ÊTRE UN SECRET
# L'URL Supabase et la clé « anon » sont forcément livrées au navigateur : une
# application web ne peut rien cacher à celui qui l'utilise. Les mettre en
# variable d'environnement les retire du DÉPÔT, pas du bundle.
# Ce qui les rend inoffensives, c'est **RLS** (voir SECURITE.md).
# ─────────────────────────────────────────────────────────────────────────────
